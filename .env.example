# Шаблон настроек. Скопируйте в .env и впишите значения:
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux/macOS:           cp .env.example .env
# Файл .env в git не попадает (см. .gitignore), в репозитории хранится только этот шаблон.

# Ключ доступа к web-сервису «Проценка». Демо-ключ указан в документации сервиса.
# Внимание: переменные VITE_* вшиваются в клиентский бандл, поэтому после публикации сайта
# ключ виден любому посетителю в браузере. Скрыть его от посетителей можно только серверной частью.
VITE_FAVORIT_API_KEY=

# Базовый адрес API. По умолчанию запросы идут на тот же домен по пути /api,
# а dev-сервер Vite и nginx проксируют их на api.favorit-parts.ru.
VITE_API_BASE_URL=/api

# Только для dev и preview: куда проксировать /api (по умолчанию боевой хост сервиса).
# API_PROXY_TARGET=https://api.favorit-parts.ru
